# AI Labs by Nimbus - environment template
# Copy to `.env` and fill in real values:
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS / Linux:      cp .env.example .env
# `.env` is gitignored. This template IS committed and must contain no secrets.

# --- Server ---
PORT=3000
NODE_ENV=development
SITE_ORIGIN=http://localhost:3000

# --- Admin auth (CMS login at /login) ---
# Password for the single admin account. Use a long random string.
ADMIN_PASSWORD=change-me
# Secret used to sign session cookies. Use a long random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-secret

# --- Cloudinary media ---
# Cloud name from the Cloudinary console.
CLOUDINARY_CLOUD_NAME=your-cloud-name
# API key (settings > API keys).
CLOUDINARY_API_KEY=your-api-key
# API secret - server-side only, used to sign uploads and call the Admin API.
CLOUDINARY_API_SECRET=your-api-secret
# Unsigned upload preset name, used by the browser upload widget.
CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
# Folder inside the Cloudinary account where uploads are stored.
CLOUDINARY_FOLDER=nimbus
